#!/usr/bin/env python3
"""tm-sounds: start VEX TM and play its match sounds, which TM's Linux build never plays itself.

TM v2026_27 for Linux logs every field state change but never loads its sound files. This starts
TM, reads those log lines, and plays TM's own WAV files through the desktop audio, by default on
the motherboard's analog output (the speaker). Override with TM_SINK=<sink name> (pactl list short sinks).
Driver-period length for the 5-second countdown: TM_DRIVER_SECONDS (default 60, VIQ; VRC is 105).
Driver-switch signals (VIQ teamwork), seconds after the driver period starts: TM_SWITCH_SECONDS
(default "25,35": Warning.wav at the first, Warning2.wav at the second; "" turns them off).
TM's log has no line for the switch, so these are timed from the match start.
Fields to ignore (e.g. the skills field): TM_SKIP_FIELDS="name,name" as printed at match start.

  tm-sounds          watch TM's log files and play sounds; TM can already be open (default)
  tm-sounds --launch start TM and read its output instead
  tm-sounds --test   play the start sound once, to check the speaker
  --switch-only      with either mode: play only the driver-switch sounds (Warning, Warning2),
                     e.g. when another tm-sounds is already playing the rest (or TM_SWITCH_ONLY=1)
Log folder: TM_LOG_DIR (default ~/.VEX Tournament Manager/Logs). Text logs are followed like
tail -f; a log that is really a SQLite database is polled for new rows.
"""
import os, re, sqlite3, subprocess, sys, threading, time

APP = "com.dwabtech.TM"
SOUNDS = os.environ.get("TM_SOUNDS_DIR", f"/var/lib/flatpak/app/{APP}/current/active/files/Sounds")
TM_CMD = os.environ.get("TM_CMD")  # testing hook: a command whose output stands in for TM's
DRIVER = float(os.environ.get("TM_DRIVER_SECONDS", "60"))
SWITCH = [float(x) for x in os.environ.get("TM_SWITCH_SECONDS", "25,35").split(",") if x.strip()]

def pick_sink():
    if os.environ.get("TM_SINK"):
        return os.environ["TM_SINK"]
    try:
        out = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True, text=True).stdout
    except OSError:
        return None
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) > 1 and parts[1].startswith("alsa_output.pci-") and "analog" in parts[1]:
            return parts[1]
    return None

SINK = pick_sink()
last = {}
SWITCH_ONLY = "--switch-only" in sys.argv or os.environ.get("TM_SWITCH_ONLY") == "1"

def play(name):
    if SWITCH_ONLY and name not in ("Warning", "Warning2"):
        return
    now = time.monotonic()
    if now - last.get(name, 0) < 1.5:      # TM logs each event twice (two log formats)
        return
    last[name] = now
    path = os.path.join(SOUNDS, name + ".wav")
    cmd = os.environ.get("TM_PLAYER")
    if cmd:
        args = [cmd, path]
    else:
        args = ["paplay", "--client-name=VEX TM Sounds"] + ([f"--device={SINK}"] if SINK else []) + [path]
    print(f"tm-sounds: {name}", flush=True)
    try:
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        print(f"tm-sounds: cannot play {path}: {e}", flush=True)

timers = {}                                 # field -> pending timed sounds of its driver period
def cancel_countdown(field=None):
    for f in ([field] if field is not None else list(timers)):
        for t in timers.pop(f, []):
            t.cancel()

def after(field, seconds, sound):
    t = threading.Timer(seconds, play, args=(sound,))
    t.daemon = True
    t.start()
    timers.setdefault(field, []).append(t)

def arm_countdown(field):
    """Timed sounds of the driver period: driver switch signals, then the 5-second countdown."""
    cancel_countdown(field)
    for i, sec in enumerate(SWITCH):
        if 0 < sec < DRIVER:
            after(field, sec, "Warning" if i == 0 else "Warning2")
    if DRIVER > 5:
        after(field, DRIVER - 5, "FiveSecondCountdown")

# Fields to ignore entirely, e.g. the skills field: TM_SKIP_FIELDS="3" or "3,4"
# (the field name as tm-sounds prints it when a match starts)
SKIP = {x.strip().lower() for x in os.environ.get("TM_SKIP_FIELDS", "").split(",") if x.strip()}
def fieldname(tok):
    return tok.strip("()[]:,'\"").lower()

aborted_at = 0.0
RULES = [
    (re.compile(r"FC: Starting field (\S+) \((AUTONOMOUS|DRIVER_CTRL)"), "start"),
    (re.compile(r"FC: Pausing field (\S+)"), "pause"),
    (re.compile(r"MATCH_ABORTED|Abort Match"), "abort"),
    (re.compile(r"FC: Stopping field (\S+)"), "stop"),
]

def handle(line):
    global aborted_at
    for rx, ev in RULES:
        m = rx.search(line)
        if not m:
            continue
        field = fieldname(m.group(1)) if m.groups() else None
        if field is not None and field in SKIP:
            return
        if ev == "start":
            print(f"tm-sounds: field {field} started ({m.group(2)})", flush=True)
            play("Start")
            if m.group(2) == "DRIVER_CTRL":
                arm_countdown(field)
            else:
                cancel_countdown(field)
        elif ev == "pause":
            cancel_countdown(field); play("Pause")
        elif ev == "abort":
            cancel_countdown(); aborted_at = time.monotonic(); play("Abort")
        elif ev == "stop":
            cancel_countdown(field)
            if time.monotonic() - aborted_at > 2:   # a natural end, not the stop after an abort
                play("Stop")
        return

LOG_DIR = os.environ.get("TM_LOG_DIR", os.path.expanduser("~/.VEX Tournament Manager/Logs"))

class TextLog:
    def __init__(self, path):
        self.path, self.f, self.ino, self.buf = path, None, None, ""
        self.open(at_end=True)
    def open(self, at_end):
        try:
            f = open(self.path, "r", errors="replace")
        except OSError:
            return
        if self.f: self.f.close()
        self.f, self.ino, self.buf = f, os.fstat(f.fileno()).st_ino, ""
        if at_end: f.seek(0, 2)
    def poll(self):
        try:
            st = os.stat(self.path)
        except OSError:
            return []
        if self.f is None or st.st_ino != self.ino or st.st_size < self.f.tell():
            self.open(at_end=self.f is None)        # rotated or truncated: read the new file from the top
            if self.f is None: return []
        self.buf += self.f.read()
        *lines, self.buf = self.buf.split("\n")
        return lines

class SqliteLog:
    def __init__(self, path):
        self.path, self.last = path, {}
        for t in self.tables():
            self.last[t] = self.maxrow(t)
    def db(self):
        return sqlite3.connect(f"file:{self.path}?mode=ro", uri=True, timeout=0.5)
    def tables(self):
        try:
            with self.db() as c:
                return [r[0] for r in c.execute("select name from sqlite_master where type='table'")]
        except sqlite3.Error:
            return list(self.last)
    def maxrow(self, t):
        try:
            with self.db() as c:
                return c.execute(f'select coalesce(max(rowid),0) from "{t}"').fetchone()[0]
        except sqlite3.Error:
            return 0
    def poll(self):
        out = []
        try:
            c = self.db()
            for t in self.tables():
                start = self.last.setdefault(t, 0)
                for row in c.execute(f'select rowid, * from "{t}" where rowid > ? order by rowid', (start,)):
                    self.last[t] = row[0]
                    out.append(" ".join(str(v) for v in row[1:] if isinstance(v, (str, int, float))))
            c.close()
        except sqlite3.Error:
            pass                                    # TM is writing; try again next round
        return out

def is_sqlite(path):
    try:
        with open(path, "rb") as f:
            return f.read(16) == b"SQLite format 3\x00"
    except OSError:
        return False

def watch():
    if not os.path.isdir(LOG_DIR):
        sys.exit(f"tm-sounds: no TM log folder at {LOG_DIR} (start TM once, or set TM_LOG_DIR)")
    logs = {}
    print(f"tm-sounds: speaker = {SINK or 'default output'}; watching {LOG_DIR}"
          + ("; driver-switch sounds only" if SWITCH_ONLY else ""), flush=True)
    while True:
        for name in os.listdir(LOG_DIR):
            path = os.path.join(LOG_DIR, name)
            if path in logs or not re.fullmatch(r"[^.].*\.log", name) or not os.path.isfile(path):
                continue                            # skip rotated copies (.log.1) and the -journal
            logs[path] = SqliteLog(path) if is_sqlite(path) else TextLog(path)
        for log in logs.values():
            for line in log.poll():
                handle(line)
        time.sleep(0.2)

def main():
    if "--test" in sys.argv:
        print(f"tm-sounds: speaker = {SINK or 'default output'}")
        play("Start"); time.sleep(3); return
    if "--launch" not in sys.argv and not TM_CMD:
        try:
            watch()
        except KeyboardInterrupt:
            return
    cmd = TM_CMD.split() if TM_CMD else ["flatpak", "run", "--env=PYTHONUNBUFFERED=1", "--command=sh", APP, "-c", "cd /app; exec ./TM"]
    print(f"tm-sounds: speaker = {SINK or 'default output'}; starting TM", flush=True)
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1, errors="replace")
    for line in p.stdout:
        handle(line)
    sys.exit(p.wait())

if __name__ == "__main__":
    main()
