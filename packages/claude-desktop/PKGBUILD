# Repack of Anthropic's official Claude Desktop (Linux beta) Debian build.
# Source: https://downloads.claude.ai/claude-desktop/apt/stable (signing key 31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE)
# Bump with ./update.sh, which verifies the signed apt index before pinning the new sha256.
pkgname=claude-desktop
pkgver=2.42304.0
pkgrel=1
pkgdesc='Claude desktop app (Chat, Cowork, Claude Code), official Anthropic Linux build'
arch=('x86_64')
url='https://claude.com/download'
license=('LicenseRef-Anthropic')
depends=(
  gtk3 libnotify nss xdg-utils at-spi2-core libdrm mesa libxcb libsecret libxtst
  util-linux-libs pipewire xdg-desktop-portal xdg-desktop-portal-gtk glib2 alsa-lib
)
optdepends=(
  'gnome-keyring: keeps you signed in'
  'libappindicator-gtk3: tray icon'
  'bubblewrap: Claude Code sandbox'
  'socat: Claude Code sandbox'
  'openssh: remote sessions'
  'qemu-system-x86: Cowork VM'
  'edk2-ovmf: Cowork VM firmware'
  'virtiofsd: Cowork VM file sharing'
)
replaces=('claude-desktop-deb')
conflicts=('claude-desktop-deb' 'claude-desktop-bin')
options=('!strip' '!debug')
source=("https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_${pkgver}_amd64.deb")
sha256sums=('74cd2ccc29d24165144e455cbc872c6cc2a24a263b83e73420e95f89166d4aa4')

package() {
  bsdtar -xf data.tar.xz -C "$pkgdir"
  rm -rf "$pkgdir/usr/share/lintian"
  # Chromium sandbox helper must be setuid root
  chmod 4755 "$pkgdir/usr/lib/claude-desktop/chrome-sandbox"

  local res="$pkgdir/usr/lib/claude-desktop/resources"
  # Things the Debian postinst does at install time; we ship them as files instead.
  if [[ -f "$res/bin/ccd" ]]; then
    ln -s ../lib/claude-desktop/resources/bin/ccd "$pkgdir/usr/bin/ccd"
  fi
  if [[ -f "$res/linux-mime/com.anthropic.Claude.xml" ]]; then
    install -Dm644 "$res/linux-mime/com.anthropic.Claude.xml" \
      "$pkgdir/usr/share/mime/packages/com.anthropic.Claude.xml"
  fi
}
