# Everyday apps on top of the desktop: phone link, sync, photography, study.
pkgname=mobius-apps
pkgver=2026.10.28
pkgrel=8
pkgdesc='Mobius Linux apps: KDE Connect, Syncthing, backups, OBS, photography, study tools, LM Studio, Bambu Studio'
arch=('any')
license=('MIT')
depends=(
  # Phone link (files, notifications, clipboard, remote) and folder sync between machines
  kdeconnect syncthing
  # Home backups (mobius-backup); fuse3 lets you browse them as folders
  restic fuse3
  # Photography: RAW editing (darktable also does tethered shooting through gphoto2), editing, camera tools
  darktable rawtherapee gimp gphoto2
  # Study: flashcards for the AMT written exams, notes, PDF/handwritten notes
  anki obsidian xournalpp
  # Recording and streaming (screen capture through PipeWire + xdg-desktop-portal-hyprland;
  # hardware encoding: VAAPI on the Radeon, NVENC on the laptop RTX). Not autostarted.
  obs-studio
  # Firefox: per-site Windows disguise for the school portal
  mobius-firefox
  # Local AI models (LM Studio, official AppImage via the AUR lmstudio-bin, rebuilt into our repo).
  # GPU runs: Vulkan on the Radeon, CUDA on the laptop RTX.
  lmstudio-bin
  # 3D printing: Bambu Studio for the P1S + AMS (official AppImage via the AUR bambustudio-bin)
  bambustudio-bin
  # mobius-tm-obs: VEX Tournament Manager -> OBS scene switching (TM Public API)
  python-websockets
)
install=mobius-apps.install

package() {
  cp -a --no-preserve=ownership "$startdir/files/." "$pkgdir/"
}
