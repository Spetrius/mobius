# Mobius system tuning. Most tweaks are ported from CachyOS-Settings
# (https://github.com/CachyOS/CachyOS-Settings, GPL-3.0) at commit e27ea45c.
# Dropped: NVIDIA rules, ntsync autoload (Arch ships ntsync-autoload now), CachyOS paste/bugreport/debuginfod, Wi-Fi regdomain service, laptop audio PM.
# Added: boot guard pacman hooks, mobius-update, os-release.
pkgname=mobius-settings
pkgver=2026.10.18
pkgrel=5
pkgdesc='Mobius Linux system tuning: sysctl, zram, udev, I/O schedulers, systemd defaults, boot guard'
arch=('any')
license=('GPL-3.0-or-later')
depends=(
  zram-generator
  ntsync-autoload
  ananicy-cpp
  cachyos-ananicy-rules-git
  hdparm
  pciutils
  power-profiles-daemon
  systemd
)
optdepends=('lua-luv: for topmem')
install=mobius-settings.install

package() {
  cp -a --no-preserve=ownership "$startdir/files/." "$pkgdir/"
}
