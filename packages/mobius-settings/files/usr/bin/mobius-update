#!/bin/bash
# Safe full update: the standing update rule from the old CachyOS install, automated.
#   1. /boot must be mounted   2. full -Syu (never partial)   3. AUR updates
#   4. verify kernels landed   5. tell you if a reboot is needed
set -euo pipefail
[[ $EUID -eq 0 ]] && { echo "Run as your user, not root (it calls sudo itself)."; exit 1; }

/usr/lib/mobius/boot-guard pre
before="$(pacman -Q linux-mobius mesa linux-firmware amd-ucode 2>/dev/null || true)"

if ! sudo pacman -Syu; then
    echo "pacman failed. If it was a keyring error, run:"
    echo "  sudo pacman -Sy archlinux-keyring && mobius-update"
    exit 1
fi
command -v paru >/dev/null && paru -Sua

sudo /usr/lib/mobius/boot-guard post
after="$(pacman -Q linux-mobius mesa linux-firmware amd-ucode 2>/dev/null || true)"
if [[ "$before" != "$after" ]]; then
    echo "Kernel, mesa, firmware or microcode changed: reboot when convenient."
fi
