# The Mobius base system on top of Arch's "base".
pkgname=mobius-base
pkgver=2026.10.18
pkgrel=4
pkgdesc='Mobius Linux base: kernel, boot, snapshots, tuning, networking, tools, Claude'
arch=('any')
license=('MIT')
depends=(
  base base-devel linux-firmware amd-ucode
  linux-mobius linux-mobius-headers
  mobius-settings mobius-keyring
  # Boot + snapshots (Limine, btrfs, snapper; snapshot boot entries like CachyOS)
  limine efibootmgr btrfs-progs snapper snap-pac limine-snapper-sync limine-mkinitcpio-hook btrfs-assistant inotify-tools
  # Networking
  networkmanager tailscale openssh
  # Shell and everyday tools
  fish git nano sudo man-db man-pages htop btop jq bc wget curl rsync
  smartmontools ntfs-3g exfatprogs dosfstools
  # Firmware updates (SSDs, docks, peripherals) and security advisories for installed packages
  fwupd arch-audit
  # AUR helper (built from source)
  paru
  # Containers / apps
  flatpak
  # Claude
  claude-code claude-desktop bubblewrap socat ripgrep
)

package() { :; }
