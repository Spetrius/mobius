# Fonts used by Mobius themes that Arch doesn't package.
# Rajdhani (Indian Type Foundry, SIL OFL 1.1): the angular HUD face of the Cyberdeck theme.
pkgname=mobius-fonts
pkgver=2026.11.01
pkgrel=1
pkgdesc='Fonts for Mobius themes: Rajdhani'
arch=('any')
license=('OFL-1.1')
url='https://fonts.google.com/specimen/Rajdhani'
_commit=6c1dbe27dcf7d817d4b62cec033ba77fa8e2a5ec   # google/fonts
_base="https://raw.githubusercontent.com/google/fonts/$_commit/ofl/rajdhani"
source=("$_base/Rajdhani-Light.ttf" "$_base/Rajdhani-Regular.ttf" "$_base/Rajdhani-Medium.ttf"
        "$_base/Rajdhani-SemiBold.ttf" "$_base/Rajdhani-Bold.ttf" "$_base/OFL.txt")
sha256sums=('140e9f13af69538161c5780fcf7f81594c069aea887e7bffd417ae1c641213c3'
            '6e1fc228a8318251a6e569502ec57bac1e4656c582f92f59ccecc4688e039b98'
            '12ff7dcfe4c206e3875ac53b1762eab57de6a2fa7f5a86c26b97b88d6591eac2'
            '94bbd25a18ca665999feb05a537de9fd2b860dcfb78bbe9ca00270825bf235da'
            '691470dd3286a14e9677940d0bf75796179841ba5215cbda1a2c8910a3226afd'
            'f62ef357d3a1c3d27edd35a6e1ba350e8a8d13499797964eeadefbf0b3b15d1f')

package() {
  install -Dm644 -t "$pkgdir/usr/share/fonts/TTF" Rajdhani-*.ttf
  install -Dm644 OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
}
