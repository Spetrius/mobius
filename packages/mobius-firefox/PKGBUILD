# Firefox extensions for Mobius, installed for every profile in Firefox's own extension folder.
# Arch builds Firefox with unsigned add-ons allowed in that folder (--with-unsigned-addon-scopes=app),
# so they need no addons.mozilla.org signing.
#   windows-disguise: per-site Windows disguise for portals that refuse Linux (toolbar button)
pkgname=mobius-firefox
pkgver=2026.11.02
pkgrel=3
pkgdesc='Mobius Firefox extensions: per-site Windows disguise'
arch=('any')
license=('MIT')
depends=(firefox)
makedepends=(zip)

_extdir=usr/lib/firefox/browser/extensions

build() {
  rm -f "$srcdir/windows-disguise.xpi"
  (cd "$startdir/ext/windows-disguise" && zip -qrX9 "$srcdir/windows-disguise.xpi" .)
}

package() {
  install -Dm644 "$srcdir/windows-disguise.xpi" "$pkgdir/$_extdir/windows-disguise@mobius.local.xpi"
  # Firefox only looks in its own extension folder at startup if told to (default: only after a
  # Firefox update), so new, updated or removed Mobius extensions would otherwise go unnoticed.
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/firefox/browser/defaults/preferences/mobius.js" <<'END'
// Scan Firefox's own extension folder (application scope = 4) at every startup
pref("extensions.startupScanScopes", 4);
END
}
