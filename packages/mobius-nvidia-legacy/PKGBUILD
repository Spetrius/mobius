# NVIDIA for Mobius on older cards: Maxwell, Pascal and Volta (GTX 900/1000, Quadro M/P, e.g. the
# lab PCs' Quadro P2000). NVIDIA's current driver (590+) and the open kernel modules dropped these,
# so they run the 580 legacy branch (AUR nvidia-580xx-*, rebuilt into our repo), built by DKMS
# against linux-mobius. Desktop cards that drive the screens: no PRIME offload, no runtime sleep.
# Turing (RTX 20) and newer use mobius-nvidia instead; the installer picks by PCI device ID.
pkgname=mobius-nvidia-legacy
pkgver=2026.11.14
pkgrel=1
pkgdesc='Mobius Linux NVIDIA support for Maxwell/Pascal/Volta: 580 legacy DKMS driver, 32-bit userspace'
arch=('any')
license=('MIT')
depends=(
  nvidia-580xx-dkms dkms linux-mobius-headers
  nvidia-580xx-utils lib32-nvidia-580xx-utils
  egl-wayland libva-nvidia-driver
)
conflicts=(mobius-nvidia)

package() {
  cp -a --no-preserve=ownership "$startdir/files/." "$pkgdir/"
}
