#!/bin/bash
# Check the NVIDIA setup on a desktop with an older NVIDIA card (580 legacy driver). Read-only.
ok()   { printf '  \e[1;32mok\e[0m    %s\n' "$*"; }
bad()  { printf '  \e[1;31mFAIL\e[0m  %s\n' "$*"; fails=$((fails+1)); }
note() { printf '  \e[1;33mnote\e[0m  %s\n' "$*"; }
fails=0

echo "Driver"
if [[ -r /proc/driver/nvidia/version ]]; then
    v="$(grep -o '[0-9]\{3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}' /proc/driver/nvidia/version | head -1)"
    [[ "$v" == 580.* ]] && ok "NVIDIA 580 legacy driver loaded: $v" || note "NVIDIA driver $v loaded (expected the 580 branch)"
else
    bad "NVIDIA driver not loaded (sudo dkms status, then reboot after mobius-update)"
fi
if grep -q 'PreserveVideoMemoryAllocations: 1' /proc/driver/nvidia/params 2>/dev/null; then
    ok "video memory preserved across sleep"
else
    bad "PreserveVideoMemoryAllocations is off (sleep may corrupt the screen)"
fi
[[ "$(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null)" == Y ]] && ok "kernel modesetting on (Wayland)" \
    || bad "nvidia_drm modeset is off: Hyprland needs it. Reboot after mobius-update"
for s in nvidia-suspend nvidia-resume nvidia-hibernate; do
    systemctl is-enabled --quiet "$s" 2>/dev/null && ok "$s enabled" || bad "$s not enabled: sudo systemctl enable $s"
done

echo "Screens"
any=0
for c in /sys/class/drm/card*-*; do
    [[ -e "$c/status" && "$(cat "$c/status")" == connected ]] || continue
    card="$(basename "$c" | cut -d- -f1)"; v="$(<"/sys/class/drm/$card/device/vendor")"
    name="$(basename "$c" | cut -d- -f2-)"
    if [[ "$v" == 0x10de ]]; then ok "$name driven by the NVIDIA card"; any=1
    else note "$name plugged into the motherboard ($v): move it to the NVIDIA card for full speed"; fi
done
(( any )) || bad "no screen on the NVIDIA card"

echo "3D"
if command -v vulkaninfo >/dev/null; then
    gpu="$(vulkaninfo --summary 2>/dev/null | sed -n 's/^\s*deviceName *= *//p' | head -1)"
    [[ "$gpu" == *NVIDIA* || "$gpu" == *Quadro* || "$gpu" == *GeForce* ]] && ok "Vulkan uses: $gpu" || bad "Vulkan does not see the NVIDIA card (got: ${gpu:-nothing})"
fi

echo
(( fails )) && echo "$fails problem(s). Send this output to Claude." || echo "All automatic checks passed."
