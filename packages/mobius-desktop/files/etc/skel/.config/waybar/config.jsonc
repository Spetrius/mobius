{
  "layer": "top",
  "height": 30,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/gpu", "cpu", "memory", "backlight", "battery", "pulseaudio", "network", "tray"],
  "hyprland/workspaces": { "format": "{id}", "on-click": "activate" },
  "hyprland/window": { "max-length": 60 },
  "clock": { "format": "{:%a %b %d  %H:%M}", "tooltip-format": "{calendar}" },
  "cpu": { "format": "\uf4bc {usage}%", "interval": 3, "states": { "warning": 85, "critical": 95 } },
  "memory": { "format": "\uefc5 {percentage}%", "interval": 5, "states": { "warning": 80, "critical": 92 } },
  "custom/gpu": {
    "exec": "mobius-gpu-status", "return-type": "json",
    "format": "󰢮 {}", "interval": 3
  },
  // Laptop only: both modules disable themselves on a desktop with no battery or backlight
  "backlight": { "format": "\uf185 {percent}%", "on-scroll-up": "brightnessctl -e4 -n2 set 5%+", "on-scroll-down": "brightnessctl -e4 -n2 set 5%-" },
  "battery": {
    "format": "{icon} {capacity}%", "format-charging": "\uf0e7 {capacity}%", "format-plugged": "\uf1e6 {capacity}%",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "states": { "warning": 25, "critical": 10 }, "interval": 30
  },
  "pulseaudio": { "format": "\uf028 {volume}%", "format-muted": "\uf6a9 muted", "on-click": "pavucontrol" },
  "network": { "format-ethernet": "󰈀 {ipaddr}", "format-wifi": "\uf1eb {essid}", "format-disconnected": "offline" },
  "tray": { "spacing": 8 }
}
