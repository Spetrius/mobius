{
  "layer": "top",
  "height": 30,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/gpu", "cpu", "memory", "pulseaudio", "network", "tray"],
  "hyprland/workspaces": { "format": "{id}", "on-click": "activate" },
  "hyprland/window": { "max-length": 60 },
  "clock": { "format": "{:%a %b %d  %H:%M}", "tooltip-format": "{calendar}" },
  "cpu": { "format": "\uf4bc {usage}%", "interval": 3, "states": { "warning": 85, "critical": 95 } },
  "memory": { "format": "\uefc5 {percentage}%", "interval": 5, "states": { "warning": 80, "critical": 92 } },
  "custom/gpu": {
    "exec": "mobius-gpu-status", "return-type": "json",
    "format": "󰢮 {}", "interval": 3
  },
  "pulseaudio": { "format": "\uf028 {volume}%", "format-muted": "\uf6a9 muted", "on-click": "pavucontrol" },
  "network": { "format-ethernet": "󰈀 {ipaddr}", "format-wifi": "\uf1eb {essid}", "format-disconnected": "offline" },
  "tray": { "spacing": 8 }
}
