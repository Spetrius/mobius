{
  "layer": "top",
  "height": 30,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/gpu", "cpu", "memory", "pulseaudio", "network", "tray"],
  "hyprland/workspaces": { "format": "{id}", "on-click": "activate" },
  "hyprland/window": { "max-length": 60 },
  "clock": { "format": "{:%a %b %d  %H:%M}", "tooltip-format": "{calendar}" },
  "cpu": { "format": " {usage}%", "interval": 3 },
  "memory": { "format": " {percentage}%", "interval": 5 },
  "custom/gpu": {
    "exec": "cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -1",
    "format": "󰢮 {}%", "interval": 3
  },
  "pulseaudio": { "format": " {volume}%", "format-muted": " muted", "on-click": "pavucontrol" },
  "network": { "format-ethernet": "󰈀 {ipaddr}", "format-wifi": " {essid}", "format-disconnected": "offline" },
  "tray": { "spacing": 8 }
}
