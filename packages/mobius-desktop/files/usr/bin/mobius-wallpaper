#!/bin/bash
# Start awww (formerly swww) and show, in order of preference: ~/Pictures/Wallpapers/current.*,
# the current theme's wallpaper (mobius-theme), the Mobius default.
awww-daemon >/dev/null 2>&1 &
for _ in $(seq 1 50); do awww query >/dev/null 2>&1 && break; sleep 0.1; done
img="$(ls ~/Pictures/Wallpapers/current.* 2>/dev/null | head -1)"
[[ -n "$img" ]] || { [[ -e ~/.config/mobius/generated/wallpaper.png ]] && img=~/.config/mobius/generated/wallpaper.png; }
[[ -n "$img" ]] || img=/usr/share/mobius/wallpaper.png
exec awww img "$img" --transition-type fade
