#!/usr/bin/env python3
"""Mobius themes and layouts, switched live.

  mobius-theme                 open the picker (Super+T)
  mobius-theme list            themes and layouts, current ones marked
  mobius-theme theme NAME      switch theme (colors, fonts, wallpaper)
  mobius-theme layout NAME     switch layout (gaps, corners, borders, bar shape and position)
  mobius-theme custom [#hex]   build a theme around one color (no color: a color picker opens)
  mobius-theme ensure          write the theme files if missing (run at login and by mobius-update)

A theme is colors + fonts + wallpaper style; a layout is shapes and spacing. Any theme works with
any layout. Themes live in /usr/share/mobius/themes and ~/.local/share/mobius/themes (yours win
on equal names; copy one there to make your own), layouts likewise under .../layouts.

How it works: each app's config loads one generated file from ~/.config/mobius/generated
(Hyprland, Waybar, mako, fuzzel, Alacritty, hyprlock, GTK). Switching rewrites those files and
tells the running apps to reload; nothing else in your configs is touched.
"""
import colorsys
import json
import math
import os
import random
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

HOME = Path.home()
SYS = Path("/usr/share/mobius")
USER_DATA = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "mobius"
CONF = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
GEN = CONF / "mobius/generated"
STATE = CONF / "mobius/theme.toml"
DEFAULT_THEME, DEFAULT_LAYOUT = "mobius-green", "default"


# ------------------------------------------------------------------ loading
def catalog(kind):
    """{id: path}, system first so user files with the same id win."""
    found = {}
    for base in (SYS / kind, USER_DATA / kind):
        if base.is_dir():
            for f in sorted(base.glob("*.toml")):
                found[f.stem] = f
    return found


def load(kind, ident):
    path = catalog(kind).get(ident)
    if not path:
        sys.exit(f"no {kind[:-1]} named '{ident}'. Try: mobius-theme list")
    with open(path, "rb") as f:
        return tomllib.load(f)


def state():
    try:
        with open(STATE, "rb") as f:
            s = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        s = {}
    return s.get("theme", DEFAULT_THEME), s.get("layout", DEFAULT_LAYOUT)


def save_state(theme, layout):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(f'# Written by mobius-theme\ntheme = "{theme}"\nlayout = "{layout}"\n')


# ------------------------------------------------------------------ colors
def rgb(hexstr):
    h = hexstr.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hx(c):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(v))) for v in c)


def hypr(hexstr, alpha="ee"):           # Hyprland "rgba(rrggbbaa)"
    return f"rgba({hexstr.lstrip('#')}{alpha})"


def argb(hexstr, alpha="ee"):           # Hyprland shadow 0xAARRGGBB
    return f"0x{alpha}{hexstr.lstrip('#')}"


def css_rgba(hexstr, a):
    r, g, b = rgb(hexstr)
    return f"rgba({r}, {g}, {b}, {a})"


def from_hls(h, l, s):
    return hx(v * 255 for v in colorsys.hls_to_rgb(h % 1.0, max(0, min(1, l)), max(0, min(1, s))))


def palette_from(base):
    """A full theme palette built around one color."""
    r, g, b = (v / 255 for v in rgb(base))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    s = max(s, 0.35)
    bright = from_hls(h, min(max(l, 0.45), 0.62), max(s, 0.6))
    return {
        "bg": from_hls(h, 0.035, s * 0.7), "surface": from_hls(h, 0.07, s * 0.6),
        "overlay": from_hls(h, 0.12, s * 0.55), "accent": from_hls(h, 0.24, s * 0.8),
        "bright": bright, "border2": from_hls(h + 0.08, 0.7, s),
        "text": from_hls(h, 0.92, 0.35), "dim": from_hls(h, 0.58, 0.18),
        "bar_text": from_hls(h, 0.8, 0.7), "highlight": from_hls(h, 0.78, 0.9),
        "warn": "#ffb020", "crit": "#ff3b3b",
    }


# ------------------------------------------------------------------ generators
def gen_hypr(t, lay):
    c = t["colors"]
    glow = lay.get("glow", False)
    shadow_col = argb(c["bright"], "88") if glow else argb(c["bg"], "ee")
    return f"""-- Generated by mobius-theme ({t['name']} / {lay['name']}). Don't edit: switch with Super+T.
hl.config({{
    general = {{
        gaps_in = {lay['gaps_in']},
        gaps_out = {lay['gaps_out']},
        border_size = {lay['border_size']},
        col = {{
            active_border   = {{ colors = {{ "{hypr(c['bright'])}", "{hypr(c['border2'])}" }}, angle = 45 }},
            inactive_border = "{hypr(c['surface'], 'aa')}",
        }},
    }},
    decoration = {{
        rounding = {lay['rounding']},
        shadow = {{ enabled = {str(lay['shadow']).lower()}, range = {12 if glow else 6}, render_power = {2 if glow else 3}, color = {shadow_col} }},
        blur = {{ enabled = {str(lay['blur']).lower()}, size = 4, passes = 2, vibrancy = 0.17 }},
    }},
}})
hl.animation({{ leaf = "workspaces", enabled = true, speed = 1.94, bezier = "quick", style = "{'slide' if lay['animation'] == 'slide' else 'fade'}" }})
"""


def gen_waybar_css(t, lay):
    c, style = t["colors"], lay["bar_style"]
    ui = t["font_ui"]
    size = 15 if ui == "Rajdhani" else 13
    weight = "font-weight: 600;" if ui == "Rajdhani" else ""
    defs = "\n".join(f"@define-color {k} {v};" for k, v in c.items())
    out = [f"/* Generated by mobius-theme ({t['name']} / {lay['name']}). Switch with Super+T. */", defs, f"""
* {{ font-family: "{ui}", "JetBrainsMono Nerd Font"; font-size: {size}px; {weight} min-height: 0; }}
#clock, #cpu, #memory, #custom-gpu, #backlight, #battery, #pulseaudio, #network, #tray, #custom-power, #window {{ padding: 0 10px; }}
#cpu.warning, #memory.warning, #custom-gpu.warning, #battery.warning:not(.charging),
#pulseaudio.muted, #network.disconnected {{ color: @warn; }}
#cpu.critical, #memory.critical, #custom-gpu.critical, #battery.critical:not(.charging) {{ color: @crit; font-weight: bold; }}
#custom-power:hover {{ color: @crit; }}
tooltip {{ background: @surface; border: 1px solid @bright; color: @text; }}
"""]
    if style == "deck":
        out.append(f"""
window#waybar {{ background: {css_rgba(c['bg'], 0.92)}; color: @bar_text; border-bottom: 1px solid {css_rgba(c['bright'], 0.55)}; }}
#workspaces button {{ color: @dim; border: 1px solid {css_rgba(c['bright'], 0.45)}; border-radius: 0; margin: 5px 3px; padding: 0 7px; background: transparent; }}
#workspaces button.active {{ color: @highlight; border-color: @highlight; background: {css_rgba(c['border2'], 0.10)}; }}
#workspaces button:hover {{ background: {css_rgba(c['bright'], 0.15)}; box-shadow: none; }}
#clock {{ color: @highlight; letter-spacing: 1px; }}
#window {{ color: @bright; }}
.modules-right > widget > * {{ border-left: 1px solid {css_rgba(c['bright'], 0.25)}; }}
""")
    elif style == "pill":
        out.append(f"""
window#waybar {{ background: transparent; color: @bar_text; }}
.modules-left, .modules-center, .modules-right {{ background: {css_rgba(c['surface'], 0.92)}; border: 1px solid {css_rgba(c['bright'], 0.4)}; border-radius: 12px; padding: 0 6px; }}
#workspaces button {{ color: @dim; border-radius: 10px; padding: 0 8px; margin: 3px 1px; }}
#workspaces button.active {{ color: @surface; background: @highlight; }}
""")
    else:  # flat
        out.append(f"""
window#waybar {{ background: {css_rgba(c['surface'], 0.90)}; color: @bar_text; }}
#workspaces button {{ padding: 0 8px; color: @dim; border-radius: 0; }}
#workspaces button.active {{ color: @highlight; border-bottom: 2px solid @highlight; }}
""")
    return "\n".join(out)


def gen_waybar_layout(lay):
    d = {"position": lay["bar_position"], "height": lay["bar_height"]}
    if lay.get("bar_margin"):
        d["margin"] = lay["bar_margin"]
    return "// Generated by mobius-theme. Switch with Super+T.\n" + json.dumps(d, indent=2) + "\n"


def gen_mako(t, lay):
    c = t["colors"]
    return f"""# Generated by mobius-theme. Switch with Super+T.
font={t['font_ui']} 11
background-color={c['surface']}ee
text-color={c['text']}
border-color={c['bright']}
border-size={max(1, lay['border_size'])}
border-radius={lay['rounding']}
progress-color=over {c['accent']}
[urgency=critical]
border-color={c['crit']}
"""


def gen_fuzzel(t, lay):
    c = t["colors"]
    s = lambda k, a="ff": c[k].lstrip("#") + a
    return f"""# Generated by mobius-theme. Switch with Super+T.
font={t['font_ui']}:size=12
[colors]
background={s('surface', 'ee')}
text={s('text')}
prompt={s('highlight')}
input={s('text')}
match={s('bright')}
selection={s('accent')}
selection-text={s('highlight')}
selection-match={s('bright')}
border={s('bright')}
[border]
radius={lay['rounding']}
width={max(1, lay['border_size'])}
"""


def gen_alacritty(t):
    c = t["colors"]
    return f"""# Generated by mobius-theme. Switch with Super+T.
[font]
normal = {{ family = "{t['font_mono']}" }}
[colors.primary]
background = "{c['bg']}"
foreground = "{c['text']}"
[colors.cursor]
text = "{c['bg']}"
cursor = "{c['highlight']}"
[colors.selection]
text = "{c['text']}"
background = "{c['accent']}"
"""


def gen_hyprlock(t):
    c = t["colors"]
    h = lambda k: f"rgb({c[k].lstrip('#')})"
    return f"""# Generated by mobius-theme. Switch with Super+T.
general {{
    hide_cursor = true
}}
background {{
    path = screenshot
    blur_passes = 3
    blur_size = 8
    brightness = 0.6
}}
label {{
    text = $TIME
    color = {h('highlight')}
    font_size = 96
    font_family = {t['font_ui']}
    position = 0, 160
    halign = center
    valign = center
}}
label {{
    text = cmd[update:60000] date +"%A, %B %d"
    color = {h('bar_text')}
    font_size = 20
    font_family = {t['font_ui']}
    position = 0, 70
    halign = center
    valign = center
}}
input-field {{
    size = 320, 52
    position = 0, -40
    halign = center
    valign = center
    outline_thickness = 2
    outer_color = {hypr(c['bright'])}
    inner_color = {hypr(c['surface'])}
    font_color = {h('text')}
    check_color = {h('highlight')}
    fail_color = {h('crit')}
    capslock_color = {h('warn')}
    fail_text = Wrong password
    placeholder_text = Password for $USER
    dots_center = true
    fade_on_empty = false
}}
"""


def gen_gtk(t, lay):
    c = t["colors"]
    r = min(lay["rounding"], 6)
    return f"""/* Generated by mobius-theme ({t['name']}). Switch with Super+T. GTK apps pick it up when reopened. */
@define-color theme_bg_color {c['bg']};
@define-color theme_fg_color {c['text']};
@define-color theme_base_color {c['bg']};
@define-color theme_text_color {c['text']};
@define-color theme_selected_bg_color {c['accent']};
@define-color theme_selected_fg_color #ffffff;

window, .background, dialog {{ background-color: {c['bg']}; color: {c['text']}; }}
headerbar, .titlebar, menubar, toolbar, .toolbar, .primary-toolbar, statusbar {{
    background-image: none; background-color: {c['surface']}; color: {c['text']};
    border-color: {c['surface']}; box-shadow: none;
}}
statusbar {{ color: {c['dim']}; }}
.sidebar, placessidebar, placessidebar list, .shortcuts-pane, .shortcuts-pane treeview.view,
.sidebar row, placessidebar row {{ background-color: {c['surface']}; color: {c['text']}; }}
.view, iconview, treeview.view, list, row, .thunar {{ background-color: {c['bg']}; color: {c['text']}; }}
.view:selected, iconview:selected, treeview.view:selected, row:selected, *:selected {{
    background-color: {c['accent']}; color: #ffffff;
}}
.view:hover, iconview:hover, row:hover {{ background-color: {c['overlay']}; }}
entry, spinbutton, .path-bar button {{
    background-image: none; background-color: {c['surface']}; color: {c['text']};
    border-color: {c['accent']}; caret-color: {c['bright']}; border-radius: {r}px;
}}
entry:focus {{ border-color: {c['bright']}; box-shadow: inset 0 0 0 1px {c['bright']}; }}
button {{
    background-image: none; background-color: {c['surface']}; color: {c['text']};
    border-color: {c['accent']}; box-shadow: none; text-shadow: none; border-radius: {r}px;
}}
button:hover {{ background-color: {c['overlay']}; }}
button:active, button:checked {{ background-color: {c['accent']}; color: #ffffff; }}
menu, .menu, .context-menu, popover, popover.background, tooltip, tooltip.background {{
    background-color: {c['surface']}; color: {c['text']}; border-color: {c['accent']};
}}
menuitem:hover {{ background-color: {c['accent']}; color: #ffffff; }}
scrollbar {{ background-color: {c['bg']}; border-color: {c['bg']}; }}
scrollbar slider {{ background-color: {c['accent']}; }}
scrollbar slider:hover {{ background-color: {c['bright']}; }}
separator, paned separator {{ background-color: {c['surface']}; }}
link, *:link {{ color: {c['bright']}; }}
"""


# ------------------------------------------------------------------ wallpaper
def screen_size():
    try:
        mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3).stdout)
        w, h = max(((m["width"], m["height"]) for m in mons), key=lambda s: s[0] * s[1])
        return w, h
    except Exception:
        return 3840, 2160


def lemniscate(cx, cy, a, n=1400):
    pts = []
    for i in range(n + 1):
        th = 2 * math.pi * i / n
        d = 1 + math.sin(th) ** 2
        pts.append((cx + a * math.cos(th) / d, cy + a * math.sin(th) * math.cos(th) / d))
    return pts


def gen_wallpaper(t, size):
    from PIL import Image, ImageDraw, ImageFilter, ImageFont
    w, h = size
    c = t["colors"]
    bg, surf, bright, hi = rgb(c["bg"]), rgb(c["surface"]), rgb(c["bright"]), rgb(c["border2"])
    img = Image.new("RGB", (w, h), bg)
    # soft radial lift toward the centre
    glow = Image.new("L", (w, h), 0)
    ImageDraw.Draw(glow).ellipse((w * 0.15, h * 0.1, w * 0.85, h * 0.9), fill=255)
    glow = glow.filter(ImageFilter.GaussianBlur(min(w, h) // 5))
    img = Image.composite(Image.new("RGB", (w, h), surf), img, glow)
    d = ImageDraw.Draw(img)
    a = min(w * 0.36, h * 0.62)

    if t.get("wallpaper") == "deck":
        rnd = random.Random(2077)
        haze = Image.new("L", (w, h), 0)               # red haze from the top, like a lit HUD
        hd = ImageDraw.Draw(haze)
        for y in range(int(h * 0.7)):
            hd.line((0, y, w, y), fill=int(70 * (1 - y / (h * 0.7)) ** 2))
        img = Image.composite(Image.new("RGB", (w, h), bright), img, haze)
        d = ImageDraw.Draw(img)
        grid = tuple(int(v * 0.35 + b * 0.65) for v, b in zip(bright, bg))
        step = max(40, h // 24)
        for x in range(0, w, step):
            d.line((x, 0, x, h), fill=tuple(int(g * 0.45 + b * 0.55) for g, b in zip(grid, bg)))
        for y in range(0, h, step):
            d.line((0, y, w, y), fill=tuple(int(g * 0.45 + b * 0.55) for g, b in zip(grid, bg)))
        for y in range(0, h, 6):                       # scanlines
            d.line((0, y, w, y), fill=tuple(int(v * 0.8) for v in bg))
        m = h // 18                                    # corner brackets
        L = h // 8
        for (x0, y0, sx, sy) in ((m, m, 1, 1), (w - m, m, -1, 1), (m, h - m, 1, -1), (w - m, h - m, -1, -1)):
            d.line((x0, y0, x0 + sx * L, y0), fill=bright, width=3)
            d.line((x0, y0, x0, y0 + sy * L), fill=bright, width=3)
        fs = max(10, h // 90)                          # binary columns, right edge
        try:
            font = ImageFont.load_default(size=fs)
        except TypeError:                              # Pillow < 10.1
            font = ImageFont.load_default()
        dimc = tuple(int(v * 0.5 + b * 0.5) for v, b in zip(bright, bg))
        for col in range(2):
            x = w - m - (col + 1) * fs * 5
            for row in range(18):
                d.text((x, m * 2 + row * fs * 1.3), "".join(rnd.choice("01") for _ in range(4)), fill=dimc, font=font)
        hy = int(m * 2.2)                              # header rule with a gap, like a menu title line
        d.line((m, hy, w * 0.42, hy), fill=tuple(int(v * 0.6 + b * 0.4) for v, b in zip(bright, bg)), width=2)
        d.line((w * 0.46, hy, w - m, hy), fill=tuple(int(v * 0.6 + b * 0.4) for v, b in zip(bright, bg)), width=2)
        d.rectangle((w * 0.42 + 6, hy - 3, w * 0.46 - 6, hy + 3), outline=hi, width=2)
        d.line((m, h * 0.5, m + L * 0.6, h * 0.5), fill=hi, width=2)
        d.line((w - m - L * 0.6, h * 0.5, w - m, h * 0.5), fill=hi, width=2)
        pts = lemniscate(w / 2, h / 2, a)
        layer = Image.new("RGB", (w, h), (0, 0, 0))
        ld = ImageDraw.Draw(layer)
        off = max(3, h // 400)                         # chromatic split: cyan behind red
        ld.line([(x + off, y) for x, y in pts], fill=hi, width=max(2, h // 500))
        ld.line(pts, fill=bright, width=max(3, h // 360))
        for radius, strength in ((h // 40, 0.9), (h // 120, 1.0)):
            bloom = layer.convert("L").filter(ImageFilter.GaussianBlur(radius)).point(lambda v, k=strength: min(255, v * k * 1.6))
            img = Image.composite(Image.new("RGB", (w, h), bright), img, bloom)
        img.paste(layer, mask=layer.convert("L").point(lambda v: 255 if v > 10 else 0))
    else:  # ring
        pts = lemniscate(w / 2, h / 2, a)
        layer = Image.new("L", (w, h), 0)
        ImageDraw.Draw(layer).line(pts, fill=255, width=max(4, h // 300))
        for radius, strength in ((h // 30, 0.55), (h // 90, 0.8)):
            img = Image.composite(Image.new("RGB", (w, h), bright), img,
                                  layer.filter(ImageFilter.GaussianBlur(radius)).point(lambda v, s=strength: v * s))
        core = tuple(int(v * 0.6 + 255 * 0.4) for v in bright)
        img = Image.composite(Image.new("RGB", (w, h), core), img, layer.point(lambda v: v * 0.9))
    return img


# ------------------------------------------------------------------ apply
def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def run(*cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except Exception:
        pass


def apply(theme_id, layout_id, reload=True):
    t, lay = load("themes", theme_id), load("layouts", layout_id)
    old_layout = state()[1]
    write(GEN / "hypr-theme.lua", gen_hypr(t, lay))
    write(GEN / "waybar.css", gen_waybar_css(t, lay))
    write(GEN / "waybar-layout.jsonc", gen_waybar_layout(lay))
    write(GEN / "mako.conf", gen_mako(t, lay))
    write(GEN / "fuzzel.ini", gen_fuzzel(t, lay))
    write(GEN / "alacritty.toml", gen_alacritty(t))
    write(GEN / "hyprlock.conf", gen_hyprlock(t))
    write(GEN / "gtk.css", gen_gtk(t, lay))
    size = screen_size()
    cache = USER_DATA / "wallpapers" / f"{theme_id}-{size[0]}x{size[1]}.png"
    src = catalog("themes")[theme_id]
    if not cache.exists() or cache.stat().st_mtime < src.stat().st_mtime:
        cache.parent.mkdir(parents=True, exist_ok=True)
        try:
            gen_wallpaper(t, size).save(cache, optimize=True)
        except Exception as e:                      # no Pillow: keep the stock wallpaper
            print(f"(wallpaper not generated: {e})")
            cache = Path("/usr/share/mobius/wallpaper.png")
    link = GEN / "wallpaper.png"
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(cache)
    save_state(theme_id, layout_id)
    if reload and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run("hyprctl", "reload")
        if layout_id != old_layout:                 # bar position/size: restart Waybar
            run("pkill", "-x", "waybar")
            subprocess.Popen(["setsid", "-f", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            run("pkill", "-USR2", "-x", "waybar")
        run("makoctl", "reload")
        if not any((HOME / "Pictures/Wallpapers").glob("current.*")):
            run("awww", "img", str(link), "--transition-type", "fade")
    print(f"Theme: {t['name']}   Layout: {lay['name']}")
    print("GTK apps (Thunar etc.) pick up the colors when reopened.")


# ------------------------------------------------------------------ picker
def fuzzel(options, prompt):
    try:
        p = subprocess.run(["fuzzel", "--dmenu", "--prompt", prompt, "--lines", str(min(len(options), 12)), "--width", "42"],
                           input="\n".join(options), capture_output=True, text=True)
    except FileNotFoundError:
        sys.exit("fuzzel is not installed")
    return p.stdout.strip() if p.returncode == 0 else None


def pick_color():
    for cmd in (["zenity", "--color-selection", "--title=Pick a theme color"], ["hyprpicker", "-f", "hex"]):
        if shutil.which(cmd[0]):
            out = subprocess.run(cmd, capture_output=True, text=True).stdout.strip()
            if out.startswith("rgb"):
                nums = [int(float(v)) for v in out[out.index("(") + 1:out.index(")")].split(",")[:3]]
                return hx(nums)
            if out.startswith("#"):
                return out[:7]
    return None


def custom(color=None):
    color = color or pick_color()
    if not color:
        return
    if not color.startswith("#"):
        color = "#" + color
    pal = palette_from(color)
    path = USER_DATA / "themes/custom.toml"
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = [f'name = "Custom ({color})"', f'description = "Built from {color}"', 'wallpaper = "ring"',
             'font_ui = "JetBrainsMono Nerd Font"', 'font_mono = "JetBrainsMono Nerd Font"',
             'suggested_layout = "default"', "", "[colors]"] + [f'{k} = "{v}"' for k, v in pal.items()]
    path.write_text("# Made by mobius-theme custom; edit the colors freely, then pick it again.\n" + "\n".join(lines) + "\n")
    apply("custom", state()[1])


def menu():
    theme, layout = state()
    top = fuzzel(["Themes", "Layouts", "Custom color..."], "Look: ")
    if top == "Themes":
        items = {f"{'● ' if k == theme else '  '}{load('themes', k)['name']}": k for k in catalog("themes")}
        choice = fuzzel(list(items), "Theme: ")
        if choice in items:
            t = load("themes", items[choice])
            # First time on a theme with its own layout (Cyberdeck): use it; the Layouts menu still overrides
            apply(items[choice], t.get("suggested_layout", layout) if t.get("suggested_layout") in catalog("layouts") and items[choice] != theme else layout)
    elif top == "Layouts":
        items = {f"{'● ' if k == layout else '  '}{load('layouts', k)['name']}  ({load('layouts', k)['description']})": k
                 for k in catalog("layouts")}
        choice = fuzzel(list(items), "Layout: ")
        if choice in items:
            apply(theme, items[choice])
    elif top == "Custom color...":
        custom()


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "menu"
    theme, layout = state()
    if cmd == "menu":
        menu()
    elif cmd == "list":
        for kind, cur in (("themes", theme), ("layouts", layout)):
            print(kind.capitalize() + ":")
            for k in catalog(kind):
                d = load(kind, k)
                print(f"  {'*' if k == cur else ' '} {k:14} {d['name']}: {d.get('description', '')}")
    elif cmd == "theme" and len(argv) > 2:
        apply(argv[2], layout)
    elif cmd == "layout" and len(argv) > 2:
        apply(theme, argv[2])
    elif cmd == "custom":
        custom(argv[2] if len(argv) > 2 else None)
    elif cmd == "ensure":
        needed = ["hypr-theme.lua", "waybar.css", "waybar-layout.jsonc", "mako.conf", "fuzzel.ini",
                  "alacritty.toml", "hyprlock.conf", "gtk.css", "wallpaper.png"]
        if not all((GEN / f).exists() for f in needed):
            if theme not in catalog("themes"):
                theme = DEFAULT_THEME
            if layout not in catalog("layouts"):
                layout = DEFAULT_LAYOUT
            apply(theme, layout, reload=False)
            if "--reload" in argv and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
                run("hyprctl", "reload")
                if not any((HOME / "Pictures/Wallpapers").glob("current.*")):
                    run("awww", "img", str(GEN / "wallpaper.png"), "--transition-type", "fade")
    else:
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
