#!/bin/bash
# Pick the Hyprland monitor profile. "auto" lets monitors.lua detect by EDID name.
set -euo pipefail
f="$HOME/.config/hypr/monitor-profile"
case "${1:-show}" in
    home|dad|laptop) echo "$1" > "$f" ;;
    auto)     rm -f "$f" ;;
    show)     echo "profile: $(cat "$f" 2>/dev/null || echo auto)"
              hyprctl monitors 2>/dev/null | grep -E '^Monitor|description' || true; exit 0 ;;
    *)        echo "usage: mobius-monitors home|dad|laptop|auto|show"; exit 2 ;;
esac
hyprctl reload >/dev/null && echo "monitor profile: ${1}"
