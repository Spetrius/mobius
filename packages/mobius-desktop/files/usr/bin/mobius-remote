#!/bin/bash
# Remote desktop between your own machines, over Tailscale only (wayvnc + TigerVNC).
#
# On the PC you want to reach (once):   mobius-remote host on      (off to stop; status to check)
# From the laptop:                      mobius-remote [connect] [machine]   (default machine: spetlin)
#
# You log in with your normal username and password. Keyboard and mouse work, so you can wake
# the screens and type your password into the lock screen. One monitor is shown at a time:
# press Super+Alt+O in the remote window to switch to the next one.
# Only reachable on the Tailscale address, never on your home network or the internet.
set -euo pipefail
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
flag="$cfg/mobius/remote-host"
vnc="$cfg/wayvnc"
PORT=5900

usage() { sed -n '2,10s/^# \{0,1\}//p' "$0"; }

ts_ip() { tailscale ip -4 2>/dev/null | head -1; }

setup_keys() {
    mkdir -p "$vnc"; chmod 700 "$vnc"
    [[ -f "$vnc/rsa_key.pem" ]] || ssh-keygen -q -m pem -t rsa -b 3072 -N '' -f "$vnc/rsa_key.pem" >/dev/null
    if [[ ! -f "$vnc/tls_key.pem" ]]; then
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:secp384r1 -sha384 -days 3650 -nodes \
            -keyout "$vnc/tls_key.pem" -out "$vnc/tls_cert.pem" -subj "/CN=$(uname -n)" >/dev/null 2>&1
    fi
    cat > "$vnc/config" <<CONF
# Written by mobius-remote. Login is your system username + password (PAM); encrypted.
enable_auth=true
enable_pam=true
rsa_private_key_file=$vnc/rsa_key.pem
certificate_file=$vnc/tls_cert.pem
private_key_file=$vnc/tls_key.pem
CONF
    chmod 600 "$vnc"/*
}

serve() {   # run from Hyprland autostart; does nothing unless 'host on' was chosen
    [[ -f "$flag" ]] || exit 0
    command -v wayvnc >/dev/null || exit 0
    while :; do
        ip="$(ts_ip)"
        if [[ -z "$ip" ]]; then sleep 10; continue; fi             # Tailscale not up yet
        out="$(hyprctl monitors -j 2>/dev/null | python3 -c 'import json,sys
m=[x["name"] for x in json.load(sys.stdin)]
print("DP-2" if "DP-2" in m else (m[0] if m else ""))' 2>/dev/null || true)"
        wayvnc -C "$vnc/config" ${out:+-o "$out"} "$ip" "$PORT" || true
        [[ -f "$flag" ]] || exit 0                                  # turned off: stop
        sleep 5                                                     # crashed or IP changed: restart
    done
}

case "${1:-connect}" in
    host)
        case "${2:-status}" in
            on)
                command -v tailscale >/dev/null && [[ -n "$(ts_ip)" ]] || { echo "Tailscale is not connected on this machine (sudo tailscale up)."; exit 1; }
                setup_keys; mkdir -p "$(dirname "$flag")"; touch "$flag"
                if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && ! pgrep -x wayvnc >/dev/null; then
                    setsid -f "$0" serve >/dev/null 2>&1
                fi
                echo "Remote desktop is on (and starts at every login). From the laptop: mobius-remote $(uname -n)"
                echo "Reachable only at $(ts_ip):$PORT on Tailscale. Turn off: mobius-remote host off" ;;
            off)
                rm -f "$flag"; pkill -x wayvnc || true
                echo "Remote desktop is off." ;;
            status)
                if [[ -f "$flag" ]]; then
                    pgrep -x wayvnc >/dev/null && echo "on, running at $(ts_ip):$PORT" || echo "on, but not running (log out and back in, or Tailscale is down)"
                else
                    echo "off (turn on: mobius-remote host on)"
                fi ;;
            *) usage; exit 2 ;;
        esac ;;
    serve) serve ;;
    -h|--help|help) usage ;;
    connect|*)
        [[ "${1:-}" == connect ]] && shift || true
        target="${1:-spetlin}"
        command -v vncviewer >/dev/null || { echo "vncviewer (tigervnc) is not installed"; exit 1; }
        echo "Connecting to $target over Tailscale. Log in with your username and password."
        echo "In the remote window: Super+Alt+O switches monitor, F8 opens the viewer menu."
        exec vncviewer -RemoteResize=0 "$target::$PORT" ;;
esac
