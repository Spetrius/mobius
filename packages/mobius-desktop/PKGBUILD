# Mobius desktop: Hyprland (Lua config, no UWSM), greetd login, default user config in /etc/skel.
pkgname=mobius-desktop
pkgver=2026.10.18
pkgrel=8
pkgdesc='Mobius Linux Hyprland desktop and default configs'
arch=('any')
license=('MIT')
depends=(
  hyprland xdg-desktop-portal-hyprland xdg-desktop-portal-gtk hyprpolkitagent hyprlock hypridle
  awww waybar mako fuzzel alacritty fish
  greetd greetd-tuigreet gnome-keyring libsecret seahorse
  thunar thunar-volman gvfs tumbler udiskie
  grim slurp wl-clipboard cliphist playerctl pavucontrol network-manager-applet brightnessctl
  bluez bluez-utils blueman
  qt5-wayland qt6-wayland qt6ct nwg-look
  pipewire pipewire-pulse pipewire-alsa wireplumber
  ttf-jetbrains-mono-nerd noto-fonts noto-fonts-cjk noto-fonts-emoji
)
install=mobius-desktop.install

package() {
  cp -a --no-preserve=ownership "$startdir/files/." "$pkgdir/"
}
